# Database (Supabase Postgres)
# DATABASE_URL: Settings -> Database -> Connection string -> "Transaction" pooler (port 6543), add ?pgbouncer=true
# DIRECT_URL: same page -> "Session"/direct connection (port 5432) — used only for migrations
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Session signing secret — generate a long random string for production
JWT_SECRET="change-this-to-a-long-random-string"

# Admin login (used once by `npm run seed` to create the admin account)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# SMTP settings for the contact form
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASSWORD="smtp-password"
SMTP_FROM="Phil Korean Medicine Hospital <no-reply@example.com>"

# Where contact form submissions are delivered
CONTACT_TO_EMAIL="admin@example.com"

# Public site URL (used for absolute links / metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
